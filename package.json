{
  "name": "@stefafafan/skm",
  "version": "0.1.0",
  "private": false,
  "description": "Agents skills manager",
  "homepage": "https://github.com/stefafafan/skm",
  "bugs": {
    "url": "https://github.com/stefafafan/skm/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stefafafan/skm.git"
  },
  "bin": {
    "skm": "dist/src/cli.js"
  },
  "files": [
    "dist/**/*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "oxlint src test",
    "lint:fix": "oxlint --fix src test",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "pnpm run build && node --test \"dist/test/**/*.test.js\"",
    "prepublishOnly": "pnpm test"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.56.0",
    "typescript": "^5.9.2"
  },
  "packageManager": "pnpm@10.27.0"
}
