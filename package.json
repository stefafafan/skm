{
  "name": "@stefafafan/skm",
  "version": "0.2.2",
  "type": "module",
  "private": false,
  "description": "A package manager for AI Agent Skills. Reproducible installs and consistent naming for teams.",
  "keywords": [
    "agents",
    "cli",
    "developer-tools",
    "skills"
  ],
  "homepage": "https://github.com/stefafafan/skm",
  "bugs": {
    "url": "https://github.com/stefafafan/skm/issues"
  },
  "license": "MIT",
  "author": "stefafafan",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stefafafan/skm.git"
  },
  "bin": {
    "skm": "dist/src/cli.js"
  },
  "files": [
    "dist/src/**/*",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "pnpm run clean && tsc -p tsconfig.json",
    "lint": "oxlint src test",
    "lint:fix": "oxlint --fix src test",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "pnpm run build && node --test \"dist/test/**/*.test.js\""
  },
  "dependencies": {
    "cac": "^7.0.0",
    "ink": "^6.8.0",
    "neverthrow": "^8.2.0",
    "react": "^19.2.4"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "@types/react": "^19.2.14",
    "oxfmt": "^0.42.0",
    "oxlint": "^1.56.0",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.2"
  },
  "packageManager": "pnpm@10.32.1"
}
